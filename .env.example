# Portfolio Web Demo Mode (Set to true to run 100% standalone with zero backend required)
NEXT_PUBLIC_DEMO_MODE=true

# Real Backend URL (Optional: connect to live NestJS server)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Stripe Publishable Key (Optional: in Demo Mode, a sleek simulated credit card gateway is provided)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
